{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc",
		"declaration": false,
		"types": ["node"],
		"module": "commonjs",
		"allowJs": true,
		"checkJs": false,
		"noEmit": false
