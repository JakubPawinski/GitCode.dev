FROM python:3.12-slim AS builder

ARG AI_DATABASE_URL
ENV AI_DATABASE_URL=${AI_DATABASE_URL}

WORKDIR /app

# Install build dependencies for psycopg2
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN pip install --no-cache-dir poetry==1.8.2

# Copy dependency files
COPY apps/ai-service/pyproject.toml apps/ai-service/poetry.lock* ./

# Configure poetry
RUN poetry config virtualenvs.in-project true && \
    poetry install --no-interaction --no-ansi --only main --no-root

# Production stage
FROM python:3.12-slim AS runner

WORKDIR /app

# Install only runtime dependencies (libpq5 for psycopg2)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY apps/ai-service/app ./app
COPY apps/ai-service/migrations ./migrations
COPY apps/ai-service/alembic.ini ./alembic.ini

# Create non-root user
RUN useradd -m -u 1000 aiservice && chown -R aiservice:aiservice /app
USER aiservice

# Activate virtual environment
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 4006

# Run migrations and start server
CMD ["sh", "-c", "alembic upgrade head && python -m app.main"]