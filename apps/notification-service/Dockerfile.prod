FROM node:20-alpine AS builder
WORKDIR /workspace

ARG NOTIFICATION_DATABASE_URL
ENV NOTIFICATION_DATABASE_URL=${NOTIFICATION_DATABASE_URL}

COPY package*.json ./
COPY nx.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/notification-service ./apps/notification-service

RUN npm ci
RUN npx nx run notification-service:prisma-generate
RUN npx nx build notification-service --prod

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /workspace/dist/apps/notification-service ./
COPY --from=builder /workspace/apps/notification-service/prisma ./prisma

COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force
RUN npx prisma generate

EXPOSE 4003

CMD ["sh", "-c", "npx prisma migrate deploy && node main.js"]